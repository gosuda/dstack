#!/usr/bin/env bash

# Resolves one PR review thread by its full node ID.
# Emits {"id": "...", "isResolved": true} on success. Rejects GraphQL errors
# and unexpected resolution state. Exit zero alone is never a receipt.
# The caller owns authorization, expected-head checks, reply confirmation,
# and partial-batch accounting. Never infers which actor changed a thread
# from its state alone.

set -e

if [ $# -eq 0 ]; then
    echo "Usage: resolve-pr-thread THREAD_ID"
    echo "Example: resolve-pr-thread PRRT_kwDOABC123"
    exit 1
fi

THREAD_ID=$1
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/odin-resolve-thread.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT
payload_file="$tmp_dir/payload.json"
resp_file="$tmp_dir/resp.json"

jq -n --arg tid "$THREAD_ID" '
  {
    query: "mutation ResolveReviewThread($threadId: ID!) { resolveReviewThread(input: { threadId: $threadId }) { thread { id isResolved } } }",
    variables: { threadId: $tid }
  }' > "$payload_file"

gh api graphql --input "$payload_file" > "$resp_file"

jq -e --arg tid "$THREAD_ID" '
  if (.errors != null and (.errors | length > 0)) then error("GraphQL errors: \(.errors)")
  elif (.data.resolveReviewThread.thread.isResolved != true) then error("thread not resolved: \(.data.resolveReviewThread.thread)")
  elif (.data.resolveReviewThread.thread.id | (type == "string" and length > 0 and . == $tid) | not) then error("unexpected thread id: \(.data.resolveReviewThread.thread.id)")
  else .data.resolveReviewThread.thread | {id, isResolved} end
' "$resp_file"
