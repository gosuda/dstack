#!/usr/bin/env bash
# Print the subagent-driven workspace directory for short-lived artifacts
# (task briefs, implementer reports, review packages, the progress ledger),
# creating it if needed.
#
# Usage: sd-workspace
set -euo pipefail

OPEN_FAILED=1
WRITE_FAILED=11

root=$(git rev-parse --show-toplevel)
dir="$root/.outline/sdd"
mkdir -p "$dir"
creation_status=0
(
  set -C
  if ! { exec 3> "$dir/.gitignore"; } 2>/dev/null; then
    exit "$OPEN_FAILED"
  fi
  printf '*\n' >&3 || exit "$WRITE_FAILED"
) || creation_status=$?
case $creation_status in
  0) ;;
  "$OPEN_FAILED")
    [ -f "$dir/.gitignore" ] || { echo "sd-workspace: cannot create $dir/.gitignore" >&2; exit 1; }
    ;;
  *) exit "$creation_status" ;;
esac
cd "$dir" && pwd
