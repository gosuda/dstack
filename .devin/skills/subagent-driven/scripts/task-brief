#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.outline/sdd/task-<N>-brief.md
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  here=$(cd "$(dirname "$0")" && pwd)
  dir=$("$here/sd-workspace")
  out="$dir/task-${n}-brief.md"
fi

# A task runs from its "Task N" heading to the next heading at the same or
# shallower depth; heading capture pauses inside CommonMark fenced code blocks
# (backtick/tilde run >=3 with <=3-space indent and, for backticks, a
# backtick-free info string; a close repeats the open char at >= its length
# followed only by whitespace).
awk -v n="$n" '
{
  line = $0
  b = line
  if (substr(b, 1, 1) == " ") b = substr(b, 2)
  if (substr(b, 1, 1) == " ") b = substr(b, 2)
  if (substr(b, 1, 1) == " ") b = substr(b, 2)
  if (fence != "") {
    if (match(b, "^" fence "+") && RLENGTH >= flen && substr(b, RLENGTH + 1) !~ /[^ \t]/) fence = ""
  } else if (match(b, /^[`~]+/) && RLENGTH >= 3) {
    run = substr(b, 1, RLENGTH)
    if (index(run, "`") == 0 || index(run, "~") == 0) {
      c = substr(run, 1, 1)
      if (c != "`" || index(substr(b, RLENGTH + 1), "`") == 0) {
        fence = c
        flen = RLENGTH
      }
    }
  } else if ($0 ~ /^#+[ \t]/) {
    match($0, /^#+/)
    d = RLENGTH
    if ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) { intask = 1; taskdepth = d; print; next }
    if (intask && d <= taskdepth) intask = 0
  }
  if (intask) print
}
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
